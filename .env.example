# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in your own values.
# Never commit real keys.
# ---------------------------------------------------------------------------

# Backend (database + server functions). Provided automatically on Lovable.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Contact form email delivery (optional).
# Without it, messages are still stored in the contact_messages table.
RESEND_API_KEY=""

# Optional: use your own 3D character instead of the built-in scene.
# Put the file in public/models/ and point this at it.
# VITE_CHARACTER_MODEL_URL="/models/devender.glb"
